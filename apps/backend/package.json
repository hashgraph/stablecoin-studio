{
  "name": "@hashgraph/stablecoin-npm-backend",
  "version": "4.2.0",
  "description": "",
  "author": "",
  "license": "Apache-2.0",
  "repository": "https://github.com/hashgraph/stablecoin-studio",
  "scripts": {
    "build": "nest build",
    "prettier": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prettier:check": "prettier --config .prettierrc --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:cov": "npx jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npx jest --config ./test/jest-e2e.json",
    "test:ci": "npx jest --ci --runInBand",
    "clear-cache": "npx jest --clearCache",
    "clean:modules": "rimraf node_modules",
    "deleteAllTransactions": "ts-node ./src/scripts/deleteAllDBTransactions.ts",
    "pre-commit": "npm run lint && npm run prettier"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.79.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "11.1.18",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/typeorm": "10.0.2",
    "@types/elliptic": "6.4.18",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "elliptic": "6.6.1",
    "ethereum-cryptography": "2.2.1",
    "nestjs-typeorm-paginate": "4.1.0",
    "pg": "8.19.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tweetnacl": "1.0.3",
    "tweetnacl-util": "0.15.1",
    "typeorm": "0.3.28",
    "uuid": "9.0.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.35",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-license-header": "0.6.1",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "29.7.0",
    "prettier": "3.5.3",
    "source-map-support": "0.5.21",
    "supertest": "6.3.4",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/*.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
